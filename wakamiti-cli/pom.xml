<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>es.wakamiti</groupId>
        <artifactId>wakamiti-runtime</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>wakamiti-cli</artifactId>
    <packaging>pom</packaging>

    <name>Wakamiti CLI</name>
    <description>Wakamiti command-line interface (CLI) module, built with Go.</description>

    <properties>
        <cli.command>waka</cli.command>

        <go.mvn.version>1.1.2</go.mvn.version>
        <gmavenplus.version>4.2.1</gmavenplus.version>
        <groovy.version>4.0.28</groovy.version>
        <go.sdk.version>1.25.6</go.sdk.version>
        <go.bin>${project.basedir}${file.separator}.go</go.bin>
        <go.coverage.report>${project.build.directory}${file.separator}coverage.out</go.coverage.report>

        <sonar.sources>${project.basedir}</sonar.sources>
        <sonar.exclusions>**/*_test.go,**/vendor/**</sonar.exclusions>
        <sonar.coverage.exclusions>**/cmd/**</sonar.coverage.exclusions>
        <sonar.tests>${project.basedir}${file.separator}internal</sonar.tests>
        <sonar.test.inclusions>**/*_test.go</sonar.test.inclusions>
        <sonar.test.exclusions>**/vendor/**</sonar.test.exclusions>
        <sonar.go.coverage.reportPaths>${go.coverage.report}</sonar.go.coverage.reportPaths>
    </properties>

    <build>
        <finalName>${cli.command}${cli.exeSuffix}</finalName>
        <plugins>
            <plugin>
                <groupId>com.igormaznitsa</groupId>
                <artifactId>gosdk-wrapper-maven-plugin</artifactId>
                <version>${go.mvn.version}</version>
                <configuration>
                    <goVersion>${go.sdk.version}</goVersion>
                    <storeFolder>${go.bin}</storeFolder>
                    <workDir>${project.basedir}</workDir>
                    <env>
                        <BUILD_DIR>${project.build.directory}</BUILD_DIR>
                    </env>
                </configuration>
                <executions>
                    <execution>
                        <id>go-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>execute</goal>
                        </goals>
                        <configuration>
                            <skip>${maven.test.skip}</skip>
                            <logFileStd>${project.build.directory}${file.separator}go-test.log</logFileStd>
                            <args>
                                <arg>test</arg>
                                <arg>-v</arg>
                                <arg>-coverprofile=${go.coverage.report}</arg>
                                <arg>./internal/...</arg>
                            </args>
                        </configuration>
                    </execution>
                    <execution>
                        <id>go-build</id>
                        <phase>package</phase>
                        <goals>
                            <goal>execute</goal>
                        </goals>
                        <configuration>
                            <args>
                                <arg>build</arg>
                                <arg>-o</arg>
                                <arg>${project.build.directory}${file.separator}${project.build.finalName}</arg>
                                <arg>./cmd/${cli.command}</arg>
                            </args>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <version>${gmavenplus.version}</version>
                <executions>
                    <execution>
                        <id>check-go-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>execute</goal>
                        </goals>
                        <configuration>
                            <scripts>
                                <script><![CDATA[
                                    if ((project.properties['maven.test.skip'] ?: 'false').toBoolean()) {
                                        log.info('Skipping Go coverage check because maven.test.skip=true')
                                        return
                                    }

                                    def reportFile = new File(project.properties['go.coverage.report'])
                                    if (!reportFile.isFile()) {
                                        throw new org.apache.maven.plugin.MojoExecutionException(
                                                "Go coverage report not found: ${reportFile}")
                                    }

                                    def totalStatements = BigDecimal.ZERO
                                    def coveredStatements = BigDecimal.ZERO

                                    reportFile.eachLine('UTF-8') { line ->
                                        def trimmed = line.trim()
                                        if (!trimmed || trimmed.startsWith('mode:')) {
                                            return
                                        }

                                        def matcher = (trimmed =~ /^.+:\d+\.\d+,\d+\.\d+\s+(\d+)\s+(\d+)$/)
                                        if (!matcher.matches()) {
                                            throw new org.apache.maven.plugin.MojoExecutionException(
                                                    "Unable to parse Go coverage report line: ${line}")
                                        }

                                        def statements = new BigDecimal(matcher.group(1))
                                        def count = new BigDecimal(matcher.group(2))
                                        totalStatements = totalStatements.add(statements)
                                        if (count.signum() > 0) {
                                            coveredStatements = coveredStatements.add(statements)
                                        }
                                    }

                                    if (totalStatements.signum() == 0) {
                                        throw new org.apache.maven.plugin.MojoExecutionException(
                                                "Go coverage report contains no statements: ${reportFile}")
                                    }

                                    def coverage = coveredStatements
                                            .multiply(new BigDecimal('100'))
                                            .divide(totalStatements, 2, java.math.RoundingMode.HALF_UP)
                                    def minimum = new BigDecimal(project.properties['jacoco.coverage'])
                                    def minimumPercent = minimum.multiply(new BigDecimal('100'))

                                    log.info("Go statement coverage: ${coverage}% (required >= ${minimumPercent}%)")
                                    if (coverage < minimumPercent) {
                                        throw new org.apache.maven.plugin.MojoExecutionException(
                                                "Go statement coverage ${coverage}% is below required ${minimumPercent}%")
                                    }
                                ]]></script>
                            </scripts>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.groovy</groupId>
                        <artifactId>groovy</artifactId>
                        <version>${groovy.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.groovy</groupId>
                        <artifactId>groovy-ant</artifactId>
                        <version>${groovy.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>go-init</id>
            <activation>
                <file>
                    <missing>${go.cached.sdk.path}</missing>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.igormaznitsa</groupId>
                        <artifactId>gosdk-wrapper-maven-plugin</artifactId>
                        <version>${go.mvn.version}</version>
                        <configuration>
                            <sdkSite>GOSDK_SITE</sdkSite>
                            <goVersion>${go.sdk.version}</goVersion>
                            <storeFolder>${go.bin}</storeFolder>
                            <workDir>${project.basedir}</workDir>
                        </configuration>
                        <executions>
                            <execution>
                                <id>cache-gosdk-export-paths</id>
                                <goals>
                                    <goal>cache-sdk</goal>
                                </goals>
                                <configuration>
                                    <propertyGoSdkPath>go.cached.sdk.path</propertyGoSdkPath>
                                    <propertyDefaultGoPath>go.default.gopath</propertyDefaultGoPath>
                                    <propertyGoCommandPath>go.command.path</propertyGoCommandPath>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
